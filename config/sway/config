# =========================================================================
# SYSTEM ENVIRONMENT VARIABLES & DEFAULT APPS
# =========================================================================
set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $term foot
set $file-manager nautilus
set $browser trivalent
set $store flatpak run io.github.kolunmi.Bazaar
set $inkscape flatpak run org.inkscape.Inkscape
set $flatseal flatpak run com.github.tchx84.Flatseal
set $password-manager keepassxc

# Screenshot Actions
#set $scsh grim -g "$(slurp)" - | wl-copy
#set $fullscsh grim - | wl-copy

# =========================================================================
# APPLICATION SHORTCUTS & WINDOW MANAGEMENT
# =========================================================================
bindsym $mod+Return exec $term
bindsym $mod+shift+f exec $file-manager #--new-window
bindsym $mod+shift+b exec $browser
bindsym $mod+shift+s exec $store
bindsym $mod+shift+i exec $inkscape
bindsym $mod+shift+p exec $flatseal
bindsym $mod+shift+d exec $password-manager
bindsym $mod+q kill
floating_modifier $mod normal
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exit

# Window Navigation (Vim Keys)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move Windows (Vim Keys)
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# =========================================================================
# WORKSPACE MANAGEMENT
# =========================================================================
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+n workspace number 11
bindsym $mod+m workspace number 12

bindsym Mod1+1 move container to workspace number 1
bindsym Mod1+2 move container to workspace number 2
bindsym Mod1+3 move container to workspace number 3
bindsym Mod1+4 move container to workspace number 4
bindsym Mod1+5 move container to workspace number 5
bindsym Mod1+6 move container to workspace number 6
bindsym Mod1+7 move container to workspace number 7
bindsym Mod1+8 move container to workspace number 8
bindsym Mod1+9 move container to workspace number 9
bindsym Mod1+0 move container to workspace number 10
bindsym Mod1+n move container to workspace number 11
bindsym Mod1+m move container to workspace number 12

# =========================================================================
# WINDOW LAYOUT MANAGER
# =========================================================================
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen

# Reassigned floating window hotkey 
bindsym $mod+space floating toggle

# Launch Noctalia Shell on startup
exec noctalia

# =========================================================================
# Custom User Modular Includes
# =========================================================================
include ~/.config/sway/user.d/*.conf

# =========================================================================
# System Launch Overrides (Must stay at the absolute bottom)
# =========================================================================
exec killall -9 waybar mako && noctalia

include ~/.config/sway/noctalia

# Import environment variables into systemd and D-Bus
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec hash dbus-update-activation-environment 2>/dev/null && \
  dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

#polkit-auth agent (mate-auth)
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1
